# Panelze panel — üretim şablonu (install-production.sh bunu .env olarak kopyalar)
# Canlıda APP_URL ve ENGINE_INTERNAL_KEY /etc/hostvim/engine.yaml ile aynı olmalı.

APP_NAME=Panelze
APP_ENV=production
APP_PROFILE=customer
APP_KEY=base64:2orKgvl8MdKd6eYiJ62r9+pgTVxY9kRhQx8DhnT5dds=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://207.180.237.13
# Zorunlu 2FA politikası; varsayılan kapalı. Açmak için: ENFORCE_ADMIN_2FA=true
ENFORCE_ADMIN_2FA=false
# Tarayıcıdan hangi host/IP ile giriliyorsa APP_URL ile aynı olmalı (vendor API host denetimi APP_URL’den türetilir).
# Örnek: http://194.163.131.213 — VENDOR_PORTAL_HOSTS boşsa bu host kullanılır.
# İsteğe bağlı açık liste: VENDOR_PORTAL_HOSTS=panel.ornek.com,194.163.131.213

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

ENGINE_API_URL=http://127.0.0.1:9090
ENGINE_INTERNAL_KEY=2abf840bc1d2d385be1b790420c00bb7160206f7357d09f35f1ab010cd6e8e7d
# Engine security.jwt_secret ile aynı (web terminal JWT); boşsa terminal kapalı
ENGINE_API_SECRET=2c890b6bb67c2df5f1ec9b7deae415bb9960aeb0c302d15f0675658f0fcde8a4

# Panel veritabanı (install-production.sh WITH_MARIADB=1 ile doldurulur)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hostvim
DB_USERNAME=hostvim
DB_PASSWORD=cc273418899cb90af7385fa281c68718

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

LOG_CHANNEL=stack
LOG_LEVEL=error

QUEUE_CONNECTION=database
CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Giden posta: kurulumda Postfix ile sendmail önerilir; SMTP/hosting sağlayıcı için Admin → Giden posta
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS="noreply@vmi2664024.contaboserver.net"
MAIL_FROM_NAME="Panelze"
# MAIL_HOST= MAIL_PORT=587 MAIL_USERNAME= MAIL_PASSWORD= MAIL_ENCRYPTION=tls

PANEL_DEFAULT_LOCALE=tr
PANEL_AVAILABLE_LOCALES=en,tr,de,fr,es

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Lisans hub (varsayılan hostvim.com — LICENSE_SERVER_URL satırı yoksa otomatik). Ek sırlı koruma için:
# LICENSE_SERVER_API_SECRET= (landing HOSTVIM_LICENSE_API_SECRET ile aynı)
# LICENSE_KEY= (isteğe bağlı; çoğu kurulumda Admin → Lisans’tan yapıştırma yeterli)

# Vendor kontrol düzlemi bu dağıtımda kapalı; lisans ve SaaS müşterileri merkezi sitede yönetilir.
# VENDOR_ENABLED=false

MYSQL_PROVISION_ENABLED=true
