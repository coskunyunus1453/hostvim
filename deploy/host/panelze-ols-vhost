#!/bin/bash
# Panelze engine (www-data) — OpenLiteSpeed vhost (httpd_config + listener map, root)
set -euo pipefail

ACTION="${1:?}"
ARG="${2:?}"

OLS_ROOT="${PANELZE_OLS_ROOT:-/usr/local/lsws}"
CTRL="${PANELZE_OLS_CTRL:-$OLS_ROOT/bin/lswsctrl}"
HTTPD_CFG="$OLS_ROOT/conf/httpd_config.conf"
BACKEND_MARK_BEGIN="# >>> panelze-ols-backend >>>"
BACKEND_MARK_END="# <<< panelze-ols-backend <<<"

ols_vhid() {
  local d="${1,,}"
  d="${d//./-}"
  echo "panelze-${d}"
}

ols_reload() {
  if [[ -x "$CTRL" ]]; then
    if ! "$CTRL" reload 2>/dev/null; then
      "$CTRL" restart
    fi
  else
    systemctl reload lshttpd 2>/dev/null || systemctl reload openlitespeed 2>/dev/null || true
  fi
}

ols_edit_httpd() {
  local py="$1"
  [[ -f "$HTTPD_CFG" ]] || { echo "panelze-ols-vhost: $HTTPD_CFG yok" >&2; exit 1; }
  python3 - "$HTTPD_CFG" <<PY
import sys
from pathlib import Path
path = Path(sys.argv[1])
text = path.read_text()
$py
path.write_text(text)
PY
}

upsert_httpd_vhost() {
  local domain="$1" vhid="$2" vhroot="$3" config_rel="$4"
  local begin="# >>> panelze-vhost ${domain} >>>"
  local end="# <<< panelze-vhost ${domain} <<<"
  ols_edit_httpd "
import re
begin = ${begin@Q}
end = ${end@Q}
block = '''${begin}
virtualHost ${vhid} {
    vhRoot                   ${vhroot}
    configFile               ${config_rel}
    allowSymbolLink          1
    enableScript             1
    restrained               0
}
${end}
'''
pat = re.compile(re.escape(begin) + r'.*?' + re.escape(end) + r'\n?', re.S)
text = pat.sub('', text)
anchor = ${BACKEND_MARK_BEGIN@Q}
if anchor not in text:
    raise SystemExit('panelze-ols-backend bloğu yok — panelze-openlitespeed-setup.sh çalıştırın')
text = text.replace(anchor, block + '\n' + anchor, 1)
"
}

remove_httpd_vhost() {
  local domain="$1"
  local begin="# >>> panelze-vhost ${domain} >>>"
  local end="# <<< panelze-vhost ${domain} <<<"
  ols_edit_httpd "
import re
begin = ${begin@Q}
end = ${end@Q}
pat = re.compile(re.escape(begin) + r'.*?' + re.escape(end) + r'\n?', re.S)
text = pat.sub('', text)
"
}

upsert_listener_map() {
  local vhid="$1" map_line="$2"
  ols_edit_httpd "
import re
begin = ${BACKEND_MARK_BEGIN@Q}
end = ${BACKEND_MARK_END@Q}
vhid = ${vhid@Q}
map_line = ${map_line@Q}
m = re.search(re.escape(begin) + r'(.*?)' + re.escape(end), text, re.S)
if not m:
    raise SystemExit('panelze-ols-backend listener bloğu yok')
body = m.group(1)
body = re.sub(r'(?m)^\\s*include\\s+conf/conf\\.d/panelze-ols-http-maps\\.conf.*\\n', '', body)
body = re.sub(r'(?m)^\\s*map\\s+' + re.escape(vhid) + r'.*\\n', '', body)
body = body.rstrip() + '\\n  ' + map_line.strip() + '\\n'
text = text[:m.start(1)] + body + text[m.end(1):]
"
}

remove_listener_map() {
  local vhid="$1"
  ols_edit_httpd "
import re
begin = ${BACKEND_MARK_BEGIN@Q}
end = ${BACKEND_MARK_END@Q}
vhid = ${vhid@Q}
m = re.search(re.escape(begin) + r'(.*?)' + re.escape(end), text, re.S)
if not m:
    raise SystemExit(0)
body = m.group(1)
body = re.sub(r'(?m)^\\s*map\\s+' + re.escape(vhid) + r'.*\\n', '', body)
text = text[:m.start(1)] + body + text[m.end(1):]
"
}

case "$ACTION" in
  apply)
    STAGING="$ARG"
    if [[ ! "$STAGING" =~ ^/var/www/[^/]+/data/ols-staging/[a-zA-Z0-9.-]+$ ]]; then
      echo "panelze-ols-vhost: izin verilmeyen staging: $STAGING" >&2
      exit 1
    fi
    DOMAIN="$(basename "$STAGING")"
    VHID="$(ols_vhid "$DOMAIN")"
    [[ -f "$STAGING/vhconf.conf" && -f "$STAGING/http-map.txt" ]] || {
      echo "panelze-ols-vhost: eksik staging dosyası" >&2
      exit 1
    }
    VH_ROOT=""
    if [[ -f "$STAGING/fragment.conf" ]]; then
      VH_ROOT="$(awk '/^[[:space:]]*vhRoot/{print $2; exit}' "$STAGING/fragment.conf")"
    fi
    if [[ -z "$VH_ROOT" && -f "$STAGING/vhroot.txt" ]]; then
      VH_ROOT="$(tr -d '\r\n' <"$STAGING/vhroot.txt")"
    fi
    if [[ -z "$VH_ROOT" ]]; then
      DOC_ROOT="$(awk '/^[[:space:]]*docRoot/{print $2; exit}' "$STAGING/vhconf.conf")"
      VH_ROOT="$(dirname "$DOC_ROOT")/.panelze/ols"
    fi
    mkdir -p "$OLS_ROOT/conf/vhosts/panelze-${DOMAIN}"
    mkdir -p "$(dirname "$VH_ROOT")"
    mkdir -p "$VH_ROOT/logs"
    cp "$STAGING/vhconf.conf" "$OLS_ROOT/conf/vhosts/panelze-${DOMAIN}/vhconf.conf"
    CONFIG_REL="conf/vhosts/panelze-${DOMAIN}/vhconf.conf"
    upsert_httpd_vhost "$DOMAIN" "$VHID" "$VH_ROOT" "$CONFIG_REL"
    upsert_listener_map "$VHID" "$(tr -d '\r' <"$STAGING/http-map.txt" | head -1)"
    if [[ -f "$STAGING/https-map.txt" ]]; then
      echo "panelze-ols-vhost: uyarı: HTTPS map nginx edge modunda OLS listener'a yazılmaz" >&2
    fi
    ols_reload
    ;;
  remove)
    DOMAIN="${ARG,,}"
    [[ "$DOMAIN" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$ ]] || {
      echo "panelze-ols-vhost: geçersiz domain" >&2
      exit 1
    }
    VHID="$(ols_vhid "$DOMAIN")"
    remove_listener_map "$VHID" || true
    remove_httpd_vhost "$DOMAIN" || true
    rm -f "$OLS_ROOT/conf/conf.d/${VHID}.conf"
    rm -rf "$OLS_ROOT/conf/vhosts/panelze-${DOMAIN}"
    ols_reload
    ;;
  *)
    echo "panelze-ols-vhost: kullanım: apply <staging-dir> | remove <domain>" >&2
    exit 1
    ;;
esac
