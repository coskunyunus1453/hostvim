#!/usr/bin/env bash
#
# Panelze panel güvenli güncelleme (root veya sudo ile).
# Müşteri verisi (data/www), panel .env ve storage korunur.
#
set -euo pipefail

VERSION=""
ARTIFACT_URL=""
ARTIFACT_SHA256=""
GIT_TAG=""
PANELZE_HOME="${PANELZE_HOME:-${PANELSAR_HOME:-/var/www/panelze}}"
LOG_FILE=""
REBUILD_ENGINE=0

usage() {
  echo "usage: panelze-panel-update --version=X.Y.Z --home=PATH [--artifact-url=URL] [--artifact-sha256=hex] [--git-tag=vX.Y.Z] [--rebuild-engine=0|1] [--log-file=PATH]" >&2
  exit 1
}

for arg in "$@"; do
  case "$arg" in
    --version=*) VERSION="${arg#*=}" ;;
    --artifact-url=*) ARTIFACT_URL="${arg#*=}" ;;
    --artifact-sha256=*) ARTIFACT_SHA256="${arg#*=}" ;;
    --git-tag=*) GIT_TAG="${arg#*=}" ;;
    --home=*) PANELZE_HOME="${arg#*=}" ;;
    --log-file=*) LOG_FILE="${arg#*=}" ;;
    --rebuild-engine=*) REBUILD_ENGINE="${arg#*=}" ;;
    -h|--help) usage ;;
    *) echo "unknown arg: $arg" >&2; usage ;;
  esac
done

[[ -n "$VERSION" ]] || usage
[[ -d "$PANELZE_HOME" ]] || { echo "PANELZE_HOME not found: $PANELZE_HOME" >&2; exit 1; }

LOCK_FILE="/var/run/panelze-panel-update.lock"
MAINT_FLAG="$PANELZE_HOME/panel/storage/framework/panelze-updating"

log() {
  local line="[$(date -Iseconds)] $*"
  if [[ -n "$LOG_FILE" ]]; then
    echo "$line" | tee -a "$LOG_FILE"
  else
    echo "$line"
  fi
}

cleanup() {
  rm -f "$MAINT_FLAG"
  rm -f "$LOCK_FILE"
}
trap cleanup EXIT

if [[ -f "$LOCK_FILE" ]]; then
  old_pid="$(cat "$LOCK_FILE" 2>/dev/null || true)"
  if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
    log "Another update is running (pid $old_pid)"
    exit 1
  fi
fi

echo $$ > "$LOCK_FILE"
mkdir -p "$(dirname "$MAINT_FLAG")"
touch "$MAINT_FLAG"

BACKUP_DIR="/var/backups/panelze"
mkdir -p "$BACKUP_DIR"
if [[ -f "$PANELZE_HOME/panel/.env" ]]; then
  cp -a "$PANELZE_HOME/panel/.env" "$BACKUP_DIR/panel-env-$(date +%Y%m%d%H%M%S).bak"
  log "Backed up panel .env"
fi

apply_git_tag() {
  local tag="$1"
  if [[ ! -d "$PANELZE_HOME/.git" ]]; then
    log "ERROR: git repo missing at $PANELZE_HOME"
    return 1
  fi
  cd "$PANELZE_HOME"
  log "==> git fetch tags"
  git fetch origin --tags --force 2>&1 | while read -r line; do log "$line"; done
  log "==> git checkout $tag"
  git checkout "$tag" 2>&1 | while read -r line; do log "$line"; done
  return 0
}

apply_artifact() {
  local url="$1"
  local sha="$2"
  local tmp
  tmp="$(mktemp -d)"
  local archive="$tmp/release.tar.gz"
  log "==> download artifact"
  curl -fsSL "$url" -o "$archive"
  if [[ -n "$sha" ]]; then
    log "==> verify sha256"
    echo "$sha  $archive" | sha256sum -c -
  fi
  mkdir -p "$tmp/extract"
  tar -xzf "$archive" -C "$tmp/extract"
  local src="$tmp/extract"
  # Tek üst klasör varsa içine gir (panelze-customer-xxx/)
  local count
  count="$(find "$tmp/extract" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')"
  if [[ "$count" == "1" ]]; then
    src="$(find "$tmp/extract" -mindepth 1 -maxdepth 1 -type d | head -1)"
  fi
  log "==> rsync release -> $PANELZE_HOME (data/.env/storage korunur)"
  rsync -a \
    --exclude '/data/' \
    --exclude '/panel/.env' \
    --exclude '/panel/storage/' \
    --exclude '/.git/' \
    "$src/" "$PANELZE_HOME/"
  rm -rf "$tmp"
}

if [[ -n "$ARTIFACT_URL" ]]; then
  apply_artifact "$ARTIFACT_URL" "$ARTIFACT_SHA256"
elif [[ -n "$GIT_TAG" ]]; then
  apply_git_tag "$GIT_TAG"
else
  log "ERROR: artifact-url or git-tag required"
  exit 1
fi

DEPLOY_SCRIPT="$PANELZE_HOME/deploy/scripts/deploy-panel.sh"
if [[ ! -f "$DEPLOY_SCRIPT" ]]; then
  log "ERROR: deploy-panel.sh missing"
  exit 1
fi

log "==> deploy-panel.sh"
export PANEL_ROOT="$PANELZE_HOME/panel"
export FRONTEND_ROOT="$PANELZE_HOME/frontend"
export REPO_ROOT="$PANELZE_HOME"
# Güncelleme sırasında git pull atlanır (kaynak zaten uygulandı)
export PANELZE_SKIP_GIT_PULL=1
bash "$DEPLOY_SCRIPT" 2>&1 | while read -r line; do log "$line"; done

if [[ "$REBUILD_ENGINE" == "1" ]] && [[ -d "$PANELZE_HOME/engine" ]]; then
  if command -v go >/dev/null 2>&1; then
    log "==> rebuild panelze-engine"
    (cd "$PANELZE_HOME/engine" && go build -o /usr/local/bin/panelze-engine ./cmd/panelze-engine) 2>&1 | while read -r line; do log "$line"; done
    if systemctl is-active panelze-engine >/dev/null 2>&1; then
      systemctl restart panelze-engine || true
    fi
  else
    log "WARN: go not found; engine not rebuilt"
  fi
fi

if command -v nginx >/dev/null 2>&1; then
  nginx -t 2>&1 | while read -r line; do log "$line"; done || true
  systemctl reload nginx 2>/dev/null || service nginx reload 2>/dev/null || true
fi

ENV_FILE="$PANELZE_HOME/panel/.env"
if [[ -f "$ENV_FILE" ]]; then
  if grep -q '^PANELZE_PANEL_VERSION=' "$ENV_FILE"; then
    sed -i.bak "s/^PANELZE_PANEL_VERSION=.*/PANELZE_PANEL_VERSION=$VERSION/" "$ENV_FILE"
    rm -f "$ENV_FILE.bak"
  else
    echo "PANELZE_PANEL_VERSION=$VERSION" >> "$ENV_FILE"
  fi
  log "==> PANELZE_PANEL_VERSION=$VERSION written to .env"
  if [[ -f "$DEPLOY_SCRIPT" ]]; then
    sudo -u www-data php "$PANELZE_HOME/panel/artisan" config:clear 2>/dev/null || true
    sudo -u www-data php "$PANELZE_HOME/panel/artisan" config:cache 2>/dev/null || true
  fi
fi

log "==> update complete: $VERSION"
exit 0
