#!/usr/bin/env bash
# Panel DNS → BIND9 zone senkronu (root; www-data sudo ile).
set -euo pipefail

PANEL_ROOT="${PANEL_ROOT:-${PANELZE_HOME:-/var/www/panelze}/panel}"

if [[ "$(id -u)" -ne 0 ]]; then
  echo "panelze-bind-sync: root gerekli" >&2
  exit 1
fi

if [[ ! -f "${PANEL_ROOT}/artisan" ]]; then
  echo "panelze-bind-sync: panel bulunamadı: ${PANEL_ROOT}" >&2
  exit 1
fi

cd "${PANEL_ROOT}"
php artisan panelze:sync-bind-dns --no-interaction
