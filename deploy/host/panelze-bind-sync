#!/usr/bin/env bash
# Panel DNS → BIND9 zone senkronu (root; www-data sudo ile).
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "panelze-bind-sync: root gerekli" >&2
  exit 1
fi

_resolve_panelze_home() {
  if [[ -n "${PANELZE_HOME:-}" && -d "${PANELZE_HOME}/panel" ]]; then
    echo "$PANELZE_HOME"
    return
  fi
  local d
  for d in /var/www/panelze /var/www/hostvim; do
    if [[ -d "$d/panel" ]]; then
      echo "$d"
      return
    fi
  done
  echo /var/www/panelze
}

_resolve_panel_root() {
  local candidate
  for candidate in \
    "${PANEL_ROOT:-}" \
    "${PANELZE_HOME:+$PANELZE_HOME/panel}" \
    "$(_resolve_panelze_home)/panel"; do
    [[ -n "$candidate" && -f "${candidate}/artisan" ]] || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

PANELZE_HOME="$(_resolve_panelze_home)"
PANEL_ROOT="$(_resolve_panel_root || true)"
if [[ -z "$PANEL_ROOT" ]]; then
  echo "panelze-bind-sync: panel bulunamadı (PANEL_ROOT / PANELZE_HOME)" >&2
  exit 1
fi

SCRIPT_DIR="${PANELZE_HOME}/deploy/scripts"
ZONES_DIR="/var/lib/bind/panelze/zones"
mkdir -p "$ZONES_DIR"
chown bind:bind "$ZONES_DIR" 2>/dev/null || true
chmod 775 "$ZONES_DIR" 2>/dev/null || true

if [[ -f "$SCRIPT_DIR/ensure-bind-config.sh" ]]; then
  bash "$SCRIPT_DIR/ensure-bind-config.sh"
fi

cd "${PANEL_ROOT}"
export PANELZE_HOME PANEL_ROOT
php artisan panelze:sync-bind-dns --no-interaction
