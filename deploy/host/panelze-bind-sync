#!/usr/bin/env bash
# Panel DNS → BIND9 zone senkronu (root; www-data sudo ile).
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "panelze-bind-sync: root gerekli" >&2
  exit 1
fi

_HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_SCRIPTS="$(cd "$_HERE/../scripts" && pwd)"
# shellcheck source=../scripts/lib/resolve-paths.sh
source "$_SCRIPTS/lib/resolve-paths.sh"

_resolve_panel_root() {
  local candidate
  for candidate in \
    "${PANEL_ROOT:-}" \
    "${PANELZE_HOME:+$PANELZE_HOME/panel}" \
    "$(resolve_panelze_home)/panel" \
    /var/www/panelze/panel \
    /var/www/hostvim/panel; do
    [[ -n "$candidate" && -f "${candidate}/artisan" ]] || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

PANELZE_HOME="${PANELZE_HOME:-$(resolve_panelze_home)}"
PANEL_ROOT="$(_resolve_panel_root || true)"
if [[ -z "$PANEL_ROOT" ]]; then
  echo "panelze-bind-sync: panel bulunamadı (PANEL_ROOT / PANELZE_HOME)" >&2
  exit 1
fi

ZONES_DIR="/var/lib/bind/panelze/zones"
mkdir -p "$ZONES_DIR"
chown bind:bind "$ZONES_DIR" 2>/dev/null || true
chmod 775 "$ZONES_DIR" 2>/dev/null || true

if [[ -f "$_SCRIPTS/ensure-bind-config.sh" ]]; then
  bash "$_SCRIPTS/ensure-bind-config.sh"
fi

# Eski hostvim zone include devre dışı kalsın (çift/eksik zone önlenir)
if [[ -f /etc/bind/named.conf.hostvim-zones ]] && grep -q 'named.conf.hostvim-zones' /etc/bind/named.conf.local 2>/dev/null; then
  bash "$_SCRIPTS/ensure-bind-config.sh"
fi

cd "${PANEL_ROOT}"
export PANELZE_HOME PANEL_ROOT
php artisan panelze:sync-bind-dns --no-interaction
