[Unit]
Description=Hostvim PM2 — Node.js uygulamalarını sunucu açılışında yükle
Documentation=https://github.com/hostvim/hostvim
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=www-data
Environment=PM2_HOME=@PM2_HOME@
Environment=HOME=@PM2_HOME@
ExecStart=/usr/bin/env pm2 resurrect
ExecStop=/usr/bin/env pm2 kill
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
