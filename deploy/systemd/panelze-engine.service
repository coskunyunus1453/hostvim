[Unit]
Description=Panelze Engine (hosting API)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Environment=PANELZE_HOME=__PANELZE_HOME__
Environment=PANELZE_CONFIG_DIR=/etc/panelze
Environment=PANELSAR_HOME=__PANELZE_HOME__
Environment=PANELSAR_CONFIG_DIR=/etc/panelze
ExecStart=__ENGINE_BINARY__
Restart=on-failure
RestartSec=5
# Güvenlik: yalnızca yerel panel erişsin (nginx üzerinden değil; doğrudan loopback)
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
